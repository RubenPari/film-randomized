# Nginx template: rendered at container start by the official nginx image
# (envsubst on /etc/nginx/templates/*.template -> /etc/nginx/conf.d/).
# Required env vars (defaults set in Dockerfile):
#   PORT        - listen port (Cloud Run injects 8080)
#   BACKEND_URL - backend base URL, e.g. https://film-randomized-back-xxxx.run.app
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json application/javascript;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Increase body size limit for API requests
    client_max_body_size 10M;

    # Health check
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Frontend React/Vite - serve static files (SPA fallback)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API proxy to backend. No URI in proxy_pass: /api/... is forwarded unchanged.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        # Cloud Run routes by Host header and requires SNI over HTTPS
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # CORS headers are handled by the backend (NestJS)
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
